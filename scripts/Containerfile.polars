ARG BASE_IMAGE=quay.io/pypa/manylinux_2_28_x86_64
FROM ${BASE_IMAGE}

ARG POLARS_RUNTIME_VERSION
ARG PYTHON_VERSION=3.14t

# manylinux_2_28 is AlmaLinux-based. Install extra system deps.
RUN dnf install -y --allowerasing \
        openssl-devel \
        pkgconfig \
        patchelf \
        cmake \
        ca-certificates \
        curl \
        gcc \
        gcc-c++ \
        make \
    && dnf clean all

# Rust toolchain (not preinstalled in pypa manylinux images).
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain stable --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/
ENV UV_LINK_MODE=copy

RUN uv python install ${PYTHON_VERSION}
RUN uv venv --python ${PYTHON_VERSION} /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN uv pip install --python /opt/venv/bin/python pip maturin

WORKDIR /src
# uv has no `pip download` subcommand; fall back to real pip inside the venv.
RUN /opt/venv/bin/python -m pip download \
        --no-binary=:all: --no-deps \
        --no-build-isolation \
        "polars-runtime-32==${POLARS_RUNTIME_VERSION}" \
        -d /src \
    && tar -xzf /src/polars_runtime_32-${POLARS_RUNTIME_VERSION}.tar.gz -C /src \
    && rm /src/polars_runtime_32-${POLARS_RUNTIME_VERSION}.tar.gz

WORKDIR /src/polars_runtime_32-${POLARS_RUNTIME_VERSION}

ENV PYO3_USE_ABI3_FORWARD_COMPATIBILITY=0
# Polars is a very large Rust build. Keep peak memory below the hosted runner's
# limit and avoid spending time generating debug information or running thin
# LTO for a wheel that is stripped before distribution. CARGO_TARGET_DIR is
# mounted by the caller so Docker never has to snapshot/export the multi-GB
# build tree as an image layer.
ENV CARGO_BUILD_JOBS=2 \
    CARGO_INCREMENTAL=0 \
    CARGO_PROFILE_RELEASE_DEBUG=false \
    CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_STRIP=debuginfo \
    CARGO_TARGET_DIR=/cargo-target

# The published sdist can contain a lockfile that needs normalization against
# its packaged manifests. Allow that one update while network access exists,
# then verify the resulting lockfile is usable offline and immutable for the
# runtime compile.
RUN cargo fetch \
        --manifest-path py-polars/runtime/polars-runtime-32/Cargo.toml \
    && cargo metadata --locked --offline --no-deps --format-version 1 \
        --manifest-path py-polars/runtime/polars-runtime-32/Cargo.toml \
        >/dev/null
ENV CARGO_NET_OFFLINE=true

CMD ["maturin", "build", "--release", "--locked", "--interpreter", "/opt/venv/bin/python", "--compatibility", "manylinux_2_28", "--out", "/out"]
